+class ScenarioHandler(Handler):
+    def do_POST(self):
+        special={'/always500':500,'/ack':202,'/redirect':302,'/rate':429,'/reject-all':401}
+        if self.path in special:
+            self._body();self._json(special[self.path],{'ignored':True});return
+        super().do_POST()
+
