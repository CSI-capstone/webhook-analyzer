+  "Unsafe document URL rejected",
+);
+check(
+  context
+    .docLink({ title: "<x>", url: "https://docs.python.org/" })
+    .includes("&lt;x&gt;"),
+  "Document title escaped",
+);
+const finding = {
+  severity: "HIGH",
+  rule_id: "WHSEC-002",
+  rule_name: "일반 비교",
+  lineno: 4,
+  filepath: "test.py",
+  message: "<danger>",
+  fix_snippet: "if x != expected:\n    reject()",
+  source_context: {
